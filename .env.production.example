# Production — copy to .env (never commit real secrets)

APP_NAME=GnKAlgo
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-64-char-random
ENCRYPTION_KEY=replace-with-32-plus-char-random

POSTGRES_USER=gnkalgo
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=gnkalgo

FRONTEND_URL=https://www.gnkalgo.com
BACKEND_PUBLIC_URL=https://www.gnkalgo.com
NEXT_PUBLIC_API_URL=
ALLOWED_ORIGINS=https://www.gnkalgo.com,https://gnkalgo.com
# Verification emails use FRONTEND_URL. Keep it https://www.gnkalgo.com in production.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=true
COOKIE_SECURE=true
# Reserved public egress IP that has also been allowlisted in DhanHQ.
DHAN_STATIC_IP=

ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TOKEN=replace-with-random-ml-token
RATE_LIMIT_ENABLED=true

DHAN_API_BASE_URL=https://api.dhan.co/v2
GROWW_API_BASE_URL=https://api.groww.in

ADMIN_EMAILS=your-login@gnkalgo.com
UPI_VPA=yourname@oksbi
UPI_PAYEE_NAME=GNK ALGO
