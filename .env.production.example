# Production / developer staging — copy to .env (never commit real secrets)

APP_NAME=GnKAlgo
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-64-char-random
ENCRYPTION_KEY=replace-with-32-plus-char-random

POSTGRES_USER=gnkalgo
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=gnkalgo

FRONTEND_URL=https://www.gnkalgo.com
BACKEND_PUBLIC_URL=https://www.gnkalgo.com
NEXT_PUBLIC_API_URL=
ALLOWED_ORIGINS=https://www.gnkalgo.com,https://gnkalgo.com
# Verification emails use FRONTEND_URL. Do not set this to dev.gnkalgo.com unless that DNS record exists.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=true
COOKIE_SECURE=true
# Reserved public egress IP that has also been allowlisted in DhanHQ.
DHAN_STATIC_IP=

ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_TOKEN=replace-with-random-ml-token
RATE_LIMIT_ENABLED=true
LIVE_TRADING_ENABLED=false
LIVE_MAX_ORDER_QUANTITY=500
LIVE_DAILY_LOSS_LIMIT=5000
BROKER_HEALTH_MAX_AGE_SECONDS=300

DHAN_API_BASE_URL=https://api.dhan.co/v2
FYERS_API_BASE_URL=https://api-t1.fyers.in/api/v3
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
GROWW_API_BASE_URL=https://api.groww.in

# Select a real provider in production; mock is rejected by readiness checks.
MARKET_DATA_PROVIDER=fyers
MARKET_DATA_FAILOVER_ENABLED=true
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=
UPSTOX_MARKET_DATA_ENABLED=false
UPSTOX_ACCESS_TOKEN=

ADMIN_EMAILS=your-login@gnkalgo.com
UPI_VPA=yourname@oksbi
UPI_PAYEE_NAME=GNK ALGO
